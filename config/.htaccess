# Los .php de /config/ solo definen funciones (no producen salida),
# pero bloqueamos el acceso directo por defensa en profundidad.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
